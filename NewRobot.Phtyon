import wpilib
from rev import CANSparkMax, CANSparkLowLevel
import math


class Robot(wpilib.TimedRobot):
    """FRC Robot program rewritten in Python for RobotPy (WPILib)."""

    # ===== Motor CAN IDs =====
    FRONT_LEFT_ID = 12
    BACK_LEFT_ID = 11
    FRONT_RIGHT_ID = 13
    BACK_RIGHT_ID = 16
    UP_MOTOR_ID = 15

    # ===== Configurable Constants =====
    LIFT_SPEED = 0.4
    AUTO_DRIVE_SPEED = 0.4
    AUTO_LIFT_SPEED = 0.4
    DEADZONE = 0.05
    SHORT_LIFT_DURATION = 0.65  # seconds
    NORMAL_SENSITIVITY = 0.6
    TURBO_SENSITIVITY = 1.0

    def robotInit(self):
        """Initialize motors, joystick, and timers."""
        self.front_left_motor = CANSparkMax(self.FRONT_LEFT_ID, CANSparkLowLevel.MotorType.kBrushed)
        self.back_left_motor = CANSparkMax(self.BACK_LEFT_ID, CANSparkLowLevel.MotorType.kBrushed)
        self.front_right_motor = CANSparkMax(self.FRONT_RIGHT_ID, CANSparkLowLevel.MotorType.kBrushed)
        self.back_right_motor = CANSparkMax(self.BACK_RIGHT_ID, CANSparkLowLevel.MotorType.kBrushed)
        self.up_motor = CANSparkMax(self.UP_MOTOR_ID, CANSparkLowLevel.MotorType.kBrushed)

        self.driver_joystick = wpilib.Joystick(0)
        self.timer = wpilib.Timer()

        # Lift state tracking
        self.lift_active = False
        self.lift_start_time = 0.0

    # ===== AUTONOMOUS =====
    def autonomousInit(self):
        self.timer.reset()
        self.timer.start()

    def autonomousPeriodic(self):
        time = self.timer.get()

        if time < 3.0:
            self.set_drive(self.AUTO_DRIVE_SPEED, self.AUTO_DRIVE_SPEED)
            self.up_motor.set(0)
        elif time < 4.0:
            self.set_drive(0, 0)
            self.up_motor.set(0)
        elif time < 5.0:
            self.set_drive(0, 0)
            self.up_motor.set(self.AUTO_LIFT_SPEED)
        else:
            self.stop_all()

    # ===== TELEOPERATED =====
    def teleopInit(self):
        self.lift_active = False

    def teleopPeriodic(self):
        # Drive control
        raw_speed = self.driver_joystick.getRawAxis(1)
        raw_turn = -self.driver_joystick.getRawAxis(4)

        raw_speed = self.apply_deadband(raw_speed)
        raw_turn = self.apply_deadband(raw_turn)

        curved_speed = math.copysign(pow(abs(raw_speed), 1.5), raw_speed)
        curved_turn = math.copysign(pow(abs(raw_turn), 1.5), raw_turn)

        turbo_mode = self.driver_joystick.getRawButton(5)
        sensitivity = self.TURBO_SENSITIVITY if turbo_mode else self.NORMAL_SENSITIVITY

        left_power = (curved_speed + curved_turn) * sensitivity
        right_power = (curved_speed - curved_turn) * sensitivity

        self.set_drive(left_power, right_power)

        # Lift control
        short_lift_pressed = self.driver_joystick.getRawButton(3)
        manual_lift_pressed = self.driver_joystick.getRawButton(1)

        # Short lift (non-blocking)
        if short_lift_pressed and not self.lift_active:
            self.lift_active = True
            self.lift_start_time = wpilib.Timer.getFPGATimestamp()

        if self.lift_active:
            if wpilib.Timer.getFPGATimestamp() - self.lift_start_time < self.SHORT_LIFT_DURATION:
                self.up_motor.set(self.LIFT_SPEED * 0.25)
            else:
                self.lift_active = False
                self.up_motor.set(0)
        elif manual_lift_pressed:
            self.up_motor.set(self.LIFT_SPEED)
        else:
            self.up_motor.set(0)

    # ===== Helper Methods =====
    def set_drive(self, left, right):
        self.front_left_motor.set(left)
        self.back_left_motor.set(left)
        self.front_right_motor.set(-right)
        self.back_right_motor.set(-right)

    def stop_all(self):
        self.set_drive(0, 0)
        self.up_motor.set(0)

    def apply_deadband(self, value):
        return 0.0 if abs(value) < self.DEADZONE else value

    # ===== Disabled / Test =====
    def disabledInit(self):
        self.stop_all()

    def testInit(self):
        self.stop_all()


if __name__ == "__main__":
    wpilib.run(Robot)

